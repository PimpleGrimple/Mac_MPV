//!PARAM cabc_gain
//!DESC CABC optical gain (linear-light multiplier). Stage is skipped when 1.0.
//!TYPE DYNAMIC float
//!MINIMUM 1.0
//!MAXIMUM 50.0
1.0

//!HOOK OUTPUT
//!BIND HOOKED
//!WHEN cabc_gain 1 >
//!DESC CABC Backlight Gain Compensation (target-sRGB diagnostic)

// Target OUTPUT is explicitly configured as sRGB TRC.
// Do NOT use mpv's compatibility linearize()/delinearize() here:
// those helpers are generated from orig_color (the source image TRC).

vec3 target_srgb_eotf(vec3 c)
{
    c = max(c, 0.0);

    return mix(
        c / 12.92,
        pow((c + 0.055) / 1.055, vec3(2.4)),
        step(vec3(0.04045), c)
    );
}

vec3 target_srgb_oetf(vec3 c)
{
    c = max(c, 0.0);

    return mix(
        c * 12.92,
        1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055,
        step(vec3(0.0031308), c)
    );
}

vec4 hook()
{
    vec4 c = HOOKED_tex(HOOKED_pos);

    // OUTPUT is target-sRGB encoded.
    vec3 linear = target_srgb_eotf(c.rgb);

    // Pure CABC compensation.
    vec3 gained = linear * cabc_gain;

    // Normalized presentation ceiling.
    gained = clamp(gained, 0.0, 1.0);

    // Return to target-sRGB encoding.
    c.rgb = target_srgb_oetf(gained);

    return c;
}