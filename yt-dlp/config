
--extractor-args "youtubepot-wpc:browser_path=/Applications/Google Chrome Beta.app/Contents/MacOS/Google Chrome Beta"
--cookies "~/.config/mpv/cache/scripts/cookies.txt"
--impersonate chrome
--force-ipv4
--retries 10
--fragment-retries 10
--socket-timeout 30
--concurrent-fragments 4
--embed-thumbnail
--embed-metadata
--embed-subs
--sub-langs "en.*,-live_chat"
--no-write-comments
--mark-watched